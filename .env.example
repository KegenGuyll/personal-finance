# Plaid API
# Get your keys from https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_secret
PLAID_ENV=sandbox

# MongoDB
# Example connections:
#   Local:   mongodb://localhost:27017/personal-finance
#   Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/personal-finance
MONGODB_URI=mongodb://localhost:27017/personal-finance

# Encrypted backups live in backup/ and use their own config file, so nothing
# above is duplicated here. See backup/README.md and backup/backup.env.example.
