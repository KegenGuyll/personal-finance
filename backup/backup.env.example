# Backup configuration for backup/scripts/*.sh.
#
# Copy to backup/backup.env on the host (chmod 0600) and mount it at
# /etc/backup/backup.env. Do NOT commit the populated file: it names the remote
# and the database, and the age recipient is the one value here that is safe to
# share but still belongs in the deployment, not the repository.
#
# Secrets are mounted as files, not env vars, so they cannot leak through
# `docker inspect` or a process environment dump:
#   AGE_RECIPIENT_FILE  (default /run/secrets/age_recipient) — public key only
#   MONGODB_URI         comes from this file; treat the file as secret

# --- Database ---------------------------------------------------------------
# Atlas today:  mongodb+srv://user:pass@cluster.mongodb.net/personal-finance
# Local after migration: mongodb://pfuser:pass@mongodb:27017/personal-finance?authSource=admin
MONGODB_URI=

# Must match DB_NAME in src/lib/mongodb.ts. A mismatch aborts the run rather than
# banking a green backup of the wrong database.
EXPECTED_DB=personal-finance

# --- Google Drive -----------------------------------------------------------
# rclone remote *name only* (no colon, no path), defined in backup/rclone.conf.
RCLONE_REMOTE=gdrive
# Folder inside that remote. Created automatically if missing.
GDRIVE_FOLDER=finance-backups

# --- Encryption -------------------------------------------------------------
# Path to the file holding ONLY the public recipient (age1...). The private key
# must never be present on this host; the scripts abort if they find one.
AGE_RECIPIENT_FILE=/run/secrets/age_recipient

# --- Retention --------------------------------------------------------------
RETENTION_DAILY_DAYS=30
RETENTION_MONTHLY_MONTHS=12
# Local ciphertext copies kept for fast restores during an incident.
RETENTION_LOCAL_DAYS=7

# --- Safety gates -----------------------------------------------------------
# Floor for a plausible archive; a dump smaller than this is treated as broken.
MIN_ARCHIVE_BYTES=10240
# Refuse to accept an archive smaller than this percentage of the previous one.
SHRINK_ALERT_PCT=50
# Free-space requirement, as a multiple of the previous archive size.
SPACE_MULTIPLIER=3
# Fail the weekly drill if no success has been recorded within this window.
STALE_AFTER_HOURS=36

# --- Secrets bundle ---------------------------------------------------------
# 1 = include the app's environment inside the encrypted archive, so a full
# recovery needs nothing from GitHub or memory.
BUNDLE_SECRETS=1
# Host path to the app's env file (mounted read-only by the compose file).
APP_ENV_FILE=/run/secrets/app_env

# --- Alerts -----------------------------------------------------------------
# ntfy topic URL, e.g. https://ntfy.sh/your-topic. Empty = log only.
NTFY_URL=
# 1 = also push a notification on success (useful when first proving the schedule).
ALERT_ON_SUCCESS=0

# --- Advanced ---------------------------------------------------------------
BACKUP_DIR=/backups
STATE_DIR=/state
# Highest server major release the pinned database tools are known to handle.
# mongodump does not publish its supported range, so this is a stated fact: bump
# it together with MONGO_TOOLS_VERSION in the Dockerfile. A server newer than this
# fails the run rather than surfacing a wire-protocol error mid-dump.
MAX_SERVER_MAJOR=8
RCLONE_CONFIG=/etc/backup/rclone.conf

# --- Off-server secret inventory (NOT values) -------------------------------
# A full recovery needs these. The values live in the places listed, and the
# archive's secrets/EXTERNAL_SECRETS.md repeats this list for whoever is
# recovering, possibly years from now.
#
#   age private key      password manager + an offline copy
#   rclone OAuth token   password manager (re-auth with the Google OAuth client)
#   Google OAuth client  Google Cloud console project
#   PLAID_CLIENT_ID      Plaid dashboard
#   PLAID_SECRET         Plaid dashboard
#   NTFY_URL             password manager
